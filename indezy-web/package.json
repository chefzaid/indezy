{
  "name": "indezy-web",
  "version": "1.31.1",
  "description": "Job tracking application for freelancers - Frontend",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "postbuild": "node scripts/prerender-home.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:e2e": "playwright test",
    "test:node": "node --check extension/background.js && node --check extension/options.js && node --test 'extension/test/*.test.mjs' 'scripts/test/*.test.mjs'",
    "lint": "ng lint && node scripts/coverage-sources.mjs --check",
    "coverage-sources": "node scripts/coverage-sources.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "chart.js": "^4.6.1",
    "leaflet": "1.9.4",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.15",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-junit-reporter": "^2.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
