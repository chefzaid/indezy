<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        MapStruct generates the *MapperImpl classes. Their defensive null checks on
        collections that our entities/DTOs never return null (custom getters return
        a fresh list) are emitted by the processor, not authored here, so SpotBugs
        findings in them are not actionable.
    -->
    <Match>
        <Class name="~.*\.mapper\..*MapperImpl"/>
    </Match>
    <!--
        RequestIdFilter returns the caller's X-Request-Id only after matching it against
        [A-Za-z0-9._-]{1,64}: no CR or LF can reach the header, so it cannot split the
        response; anything else gets a generated UUID.
    -->
    <Match>
        <Class name="dev.swirlit.indezy.config.RequestIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>
</FindBugsFilter>
